# Copiar a .env y rellenar:  cp env.example .env
# .env esta en .gitignore. No lo subas.

# Clave del API de Riot (developer.riotgames.com).
# Las de desarrollo caducan en 24 h; las personales no caducan, pero mantienen
# el limite de 100 peticiones / 2 min por host.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Mongo. Con docker compose se sobreescribe a mongodb://db:27017.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=lol_analyze

# Defaults opcionales; equivalen a los flags de la CLI.
# ETL_REGIONS=NA1
# ETL_TIERS=MASTER-CHALLENGER
# ETL_QUEUE=420
# ETL_SINCE=336h
# ETL_TIMELINES=false
# ETL_DISCOVER_WORKERS=16
# ETL_FETCH_WORKERS=24
# ETL_DISCOVER_LIMIT=0
# ETL_LOG_LEVEL=info
